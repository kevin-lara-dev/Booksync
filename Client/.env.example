# URL del backend. Es opcional: si no se define, el código ya trae como valor por
# defecto http://localhost:3000/api, que funciona si el backend corre en local
# con la configuración por defecto.
VITE_API_URL=http://localhost:3000/api

# EmailJS — OPCIONAL. Solo se usa en el formulario de "¿Necesitas ayuda?" (Help.jsx).
# Sin estas variables, el resto de la aplicación funciona con normalidad; únicamente
# ese formulario mostrará un error al intentar enviarse.
# Para probarlo, crea tu propia cuenta gratuita en https://www.emailjs.com/ y conecta
# tu propio correo — no uses las credenciales del autor original del proyecto.

# VITE_EMAILJS_SERVICE_ID: EmailJS Dashboard → Email Services → tu servicio conectado
VITE_EMAILJS_SERVICE_ID=tu_service_id

# VITE_EMAILJS_TEMPLATE_ID_CONTACT y VITE_EMAILJS_TEMPLATE_ID_AUTO:
# EmailJS Dashboard → Email Templates → tus plantillas (una para el mensaje de
# contacto y otra para la autorespuesta al usuario)
VITE_EMAILJS_TEMPLATE_ID_CONTACT=tu_template_id_contacto
VITE_EMAILJS_TEMPLATE_ID_AUTO=tu_template_id_autorespuesta

# VITE_EMAILJS_PUBLIC_KEY: EmailJS Dashboard → Account → General → Public Key
VITE_EMAILJS_PUBLIC_KEY=tu_public_key
