PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=booksync

#clave para tokens
JWT_SECRET=pon_aqui_una_clave_secreta_larga
JWT_EXPIRES_IN=8h

# correo para enviar emails de recuperación de contraseña
# usar una App Password de Gmail (Google Account → Seguridad → Contraseñas de aplicaciones)
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# URL del frontend, usada para armar el enlace de recuperación de contraseña que se envía por correo.
# En desarrollo apunta al localhost de Vite; en producción es la URL real del frontend desplegado.
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 — almacenamiento de portadas de libros
# R2_ACCOUNT_ID: Cloudflare Dashboard → R2 → en la barra lateral derecha, "Account ID"
R2_ACCOUNT_ID=tu_account_id_de_cloudflare

# R2_ACCESS_KEY_ID y R2_SECRET_ACCESS_KEY: Cloudflare Dashboard → R2 → "Manage R2 API Tokens" → Create API Token
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key

# R2_BUCKET_NAME: nombre del bucket creado en R2 (Cloudflare Dashboard → R2 → Create bucket)
R2_BUCKET_NAME=booksync-covers

# R2_PUBLIC_URL: URL pública del bucket, sin slash final.
# Se obtiene habilitando "Public access" en el bucket (R2 → tu bucket → Settings → Public Development URL,
# o el dominio personalizado que hayas conectado)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
